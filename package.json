{
  "name": "printcost",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /PrintCost/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "verify:csp": "node tools/verify-csp.mjs",
    "verify:lighthouse": "node tools/verify-lighthouse-report.mjs",
    "verify:quality": "npm run test && npx -y node@22 ./node_modules/.bin/ng build",
    "verify:release": "npm run verify:quality && npm run verify:csp && npm run verify:lighthouse"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.2",
    "idb": "^8.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
